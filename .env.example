# Local ToolDB connection for commands run from the host.
TOOLMETA_HARVESTER_DATABASE__HOST=localhost
TOOLMETA_HARVESTER_DATABASE__PORT=5432
TOOLMETA_HARVESTER_DATABASE__NAME=tooldb
TOOLMETA_HARVESTER_DATABASE__USER=admin
TOOLMETA_HARVESTER_DATABASE__PASSWORD=replace_with_local_database_password

# EGI OpenAI-compatible chat service.
TOOLMETA_HARVESTER_EGI__LLM_API_KEY=replace_with_egi_api_key
TOOLMETA_HARVESTER_EGI__LLM_API_URL=https://llm.ai.egi.eu/v1/chat/completions
TOOLMETA_HARVESTER_EGI__GENERATION_MODEL=qwen3.8-27b
TOOLMETA_HARVESTER_EGI__VALIDATION_MODEL=qwen3.8-27b

# Embedding service and request policy.
TOOLMETA_HARVESTER_EGI__EMBEDDING_API=https://llm.ai.egi.eu/v1/embeddings
TOOLMETA_HARVESTER_EGI__EMBEDDING_MODEL=nomic-embed-text-v2-moe
TOOLMETA_HARVESTER_EGI__LLM_TIMEOUT=180
TOOLMETA_HARVESTER_EGI__LLM_MAX_RETRIES=3

# Optional; only needed for GitHub harvesting, not enrichment.
TOOLMETA_HARVESTER_GITHUB__API_KEY=replace_with_github_token
